APP_NAME=commute-plan
APP_ENV=lab
APP_VERSION=0.1.0

# Logging
LOG_LEVEL=INFO              # TRACE|DEBUG|INFO|WARN|ERROR
LOG_FORMAT=json             # json|console
LOG_DEST=file:logs/commute_plan.log

# Timezone & work days
TZ=America/Chicago
# Backward compatibility for older modules/scripts:
TIMEZONE=America/Chicago
WORK_DAYS=Mon,Tue,Wed,Thu,Fri

# Paths
WEATHER_JSON=/srv/2bananas/projects/commute-plan/data/tulsa_weather.json
STATE_FILE=data/last_plan.json

# Discord
# Preferred: webhook (simple fire-and-forget)
DISCORD_WEBHOOK_URL=

# Optional: bot token + channel (if you want later)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
